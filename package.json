{
  "name": "whytide",
  "version": "0.0.0",
  "private": true,
  "description": "High-intent B2B leads from buying signals, qualified with AI, with the evidence shown",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && bash tests/skeleton.test.sh",
    "ci:local": "node tools/ci/ci.ts",
    "format": "biome check --write",
    "format:check": "biome check",
    "module:new": "node tools/module-new.mjs",
    "modules:generate": "pnpm -F api modules:generate",
    "stack:up": "bash deploy/scripts/stack.sh up",
    "stack:down": "bash deploy/scripts/stack.sh down",
    "stack:status": "bash deploy/scripts/stack.sh status",
    "env:create": "bash deploy/scripts/env.sh create",
    "env:destroy": "bash deploy/scripts/env.sh destroy",
    "env:status": "bash deploy/scripts/env.sh status",
    "deploy:check": "node deploy/scripts/deploy-check.ts",
    "images:build": "bash deploy/scripts/images-build.sh",
    "db:migrate": "pnpm -F db migrate",
    "db:migrate:dev": "pnpm -F db migrate:dev",
    "db:reset": "pnpm -F db reset",
    "db:studio": "pnpm -F db studio",
    "db:generate": "pnpm -F db generate",
    "db:migrate:check": "pnpm -F db db:migrate:check",
    "db:release-snapshot": "pnpm -F db release-snapshot",
    "credits:seed": "pnpm -F credits seed",
    "env:check": "pnpm -F platform env:check",
    "observability:check": "pnpm -F platform observability:check",
    "changeset": "changeset",
    "prepare": "node tools/ci/secrets-scan.ts hook",
    "secrets:keygen": "pnpm -F platform secrets:keygen",
    "openapi:build": "pnpm -r --if-present openapi:build",
    "client:generate": "pnpm -F web client:generate",
    "web:routes": "pnpm -F web web:routes",
    "http:run": "pnpm -F api http:run",
    "session:token": "pnpm -F api session:token",
    "invite": "pnpm -F identity invite",
    "tenant:create": "pnpm -F identity tenant:create",
    "workspace:create": "pnpm -F identity workspace:create",
    "knowledge:draft": "pnpm -F onboarding knowledge:draft",
    "smoke": "pnpm -F api smoke && pnpm -F \"./core/modules/*\" --workspace-concurrency=1 --if-present smoke",
    "rescore": "pnpm -F qualification rescore",
    "icp:draft": "pnpm -F icp icp:draft",
    "export:golden": "pnpm -F qualification export:golden",
    "grounding-sample": "pnpm -F worker grounding-sample",
    "evidence:reduce": "pnpm -F signals evidence:reduce",
    "erase": "pnpm -F privacy erase"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
