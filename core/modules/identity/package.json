{
  "name": "@whytide/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Whytide module: identity",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "node ../../packages/db/src/cli.ts generate && node ../../packages/providers/_pattern/generate.ts",
    "build": "pnpm run generate && tsc -b",
    "typecheck": "pnpm run generate && tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "pnpm run build && APP_ENV=test PROVIDER_APP_MAIL=fake node --test tests/*.test.ts",
    "test:tenancy": "pnpm run build && APP_ENV=test node --test tests/tenancy.test.ts",
    "invite": "pnpm run build && node --env-file-if-exists=../../../.env.local dist/cli/invite.js",
    "tenant:create": "pnpm run build && node --env-file-if-exists=../../../.env.local dist/cli/tenant-create.js",
    "workspace:create": "pnpm run build && node --env-file-if-exists=../../../.env.local dist/cli/workspace-create.js",
    "smoke": "pnpm run build && node --env-file-if-exists=../../../.env.local tests/smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@whytide/db": "workspace:*",
    "@whytide/platform": "workspace:*",
    "@whytide/providers": "workspace:*",
    "@whytide/tenancy": "workspace:*",
    "@whytide/ui": "workspace:*",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0"
  }
}
