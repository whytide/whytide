{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", ".tmp"],
  "references": [
    { "path": "../../packages/ai" },
    { "path": "../../packages/db" },
    { "path": "../../packages/platform" },
    { "path": "../approvals" },
    { "path": "../campaigns" },
    { "path": "../contacts" },
    { "path": "../inbox" },
    { "path": "../linkedin" },
    { "path": "../messaging" },
    { "path": "../qualification" },
    { "path": "../signals" },
    { "path": "../tenancy" }
  ]
}
