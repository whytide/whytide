{
  "name": "@whytide/discovery",
  "version": "0.0.0",
  "private": true,
  "description": "Whytide module: discovery",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "node ../../packages/db/src/cli.ts generate && node ../../packages/providers/_pattern/generate.ts",
    "build": "pnpm run generate && tsc -b",
    "typecheck": "pnpm run generate && tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "pnpm run build && APP_ENV=test node --test tests/*.test.ts",
    "test:tenancy": "pnpm run build && APP_ENV=test node --test tests/tenancy.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@temporalio/workflow": "1.24.0",
    "@whytide/contacts": "workspace:*",
    "@whytide/db": "workspace:*",
    "@whytide/platform": "workspace:*",
    "@whytide/providers": "workspace:*",
    "@whytide/ui": "workspace:*",
    "busboy": "1.6.0",
    "csv-parse": "7.0.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/react": "19.3.0"
  }
}
