{
  "name": "@whytide/campaigns",
  "version": "0.0.0",
  "private": true,
  "description": "Whytide module: campaigns",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm -F ai generate && node ../signals/scripts/kinds-generate.ts",
    "build": "pnpm run generate && tsc -b",
    "typecheck": "pnpm run generate && tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "pnpm run build && APP_ENV=test PROVIDER_LLM=fake PROVIDER_LINKEDIN=fake node --test tests/*.test.ts",
    "test:safety": "pnpm run build && APP_ENV=test PROVIDER_LLM=fake PROVIDER_LINKEDIN=fake node --test \"tests/safety/*.test.ts\"",
    "test:tenancy": "pnpm run build && APP_ENV=test PROVIDER_LLM=fake PROVIDER_LINKEDIN=fake node --test tests/tenancy.test.ts",
    "campaigns:report": "pnpm run build && node --env-file-if-exists=../../../.env.local dist/cli/report.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@temporalio/workflow": "1.24.0",
    "@whytide/approvals": "workspace:*",
    "@whytide/contacts": "workspace:*",
    "@whytide/db": "workspace:*",
    "@whytide/email": "workspace:*",
    "@whytide/linkedin": "workspace:*",
    "@whytide/platform": "workspace:*",
    "@whytide/playbooks": "workspace:*",
    "@whytide/providers": "workspace:*",
    "@whytide/qualification": "workspace:*",
    "@whytide/tenancy": "workspace:*",
    "@whytide/ui": "workspace:*",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
