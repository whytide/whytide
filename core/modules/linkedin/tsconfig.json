{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // The NestJS controller of api/ needs both (core/apps/api/README.md "Modules"); Node cannot run
    // decorated sources, so the api host loads this module's dist/, and the tests import no controller.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // The screens (ui/**/*.tsx) are the web host's to compile and check (core/apps/web/docs/screens.md):
  // no reference to the web here, which would close a cycle with the api.
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", ".tmp"],
  "references": [
    { "path": "../../packages/platform" },
    { "path": "../../packages/db" },
    { "path": "../../packages/providers" },
    { "path": "../tenancy" }
  ]
}
