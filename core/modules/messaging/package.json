{
  "name": "@whytide/messaging",
  "version": "0.0.0",
  "private": true,
  "description": "Whytide module: messaging",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm -F ai generate && node ../signals/scripts/kinds-generate.ts",
    "build": "pnpm run generate && tsc -b",
    "typecheck": "pnpm run generate && tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "pnpm run build && APP_ENV=test PROVIDER_LLM=fake node --test tests/*.test.ts",
    "test:tenancy": "pnpm run build && APP_ENV=test PROVIDER_LLM=fake node --test tests/tenancy.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@temporalio/workflow": "1.24.0",
    "@whytide/ai": "workspace:*",
    "@whytide/contacts": "workspace:*",
    "@whytide/db": "workspace:*",
    "@whytide/onboarding": "workspace:*",
    "@whytide/platform": "workspace:*",
    "@whytide/providers": "workspace:*",
    "@whytide/signals": "workspace:*",
    "@whytide/tenancy": "workspace:*",
    "@whytide/ui": "workspace:*",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
