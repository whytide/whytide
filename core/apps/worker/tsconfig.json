{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"],
  // The bundle's entry imports the modules' workflow files, which their own modules check.
  "exclude": ["dist", "node_modules", ".tmp", "src/workflows.generated.ts"],
  "references": [
    { "path": "../../packages/platform" },
    { "path": "../../packages/db" },
    { "path": "../../packages/providers" },
    { "path": "../../packages/ai" },
    { "path": "../../modules/credits" },
    { "path": "../../modules/enrichment" }
  ]
}
