{
  "name": "@whytide/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared components, design tokens, shared messages",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gallery": {
      "types": "./dist/dev/gallery.d.ts",
      "default": "./dist/dev/gallery.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./theme.css": "./theme.css",
    "./components.css": "./components.css"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "intl-messageformat": "12.1.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3"
  }
}
