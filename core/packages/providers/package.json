{
  "name": "@whytide/providers",
  "version": "0.0.0",
  "private": true,
  "description": "The ports and their adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./*/testing": {
      "types": "./dist/*/testing/index.d.ts",
      "default": "./dist/*/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../db/src/cli.ts generate && node _pattern/generate.ts && tsc -b",
    "typecheck": "node ../db/src/cli.ts generate && node _pattern/generate.ts && tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "node ../db/src/cli.ts generate && node _pattern/generate.ts && tsc -b && APP_ENV=test node --test tests/*.test.ts",
    "test:contract": "node ../db/src/cli.ts generate && node _pattern/generate.ts && tsc -b && APP_ENV=test node --test \"*/tests/*.test.ts\" \"*/*/tests/*.test.ts\"",
    "test:safety": "node ../db/src/cli.ts generate && node _pattern/generate.ts && tsc -b && APP_ENV=test node --test \"tests/safety/*.test.ts\"",
    "generate": "node _pattern/generate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/provider": "4.0.27",
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@whytide/db": "workspace:*",
    "@whytide/platform": "workspace:*",
    "ai": "7.0.139",
    "better-auth": "1.7.8",
    "nodemailer": "10.1.7",
    "zod": "4.6.7"
  }
}
