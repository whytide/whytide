// The tables of core/modules/qualification (its docs/data.md), alpha-p6-020; migrations
// 20261022191000_qualification_snapshots, 20261022195000_qualification_criteria_hash,
// 20261022211000_qualification_batch_robustness, 20261030170000_qualification_intent_scores and
// 20261102205025_qualification_member_verdicts (a member's verdict beside the model's, with the
// hand-written CHECKs that keep a row's parts together) and 20261113034207_qualification_audiences (the audience
// of a snapshot and of an attempt, with the hand-written trigger that gives a row the previous
// release inserts without one the workspace's default audience). Four
// tenant tables: a person's assessment against the ICP at one version, a score snapshot whose fit,
// confidence, tier and status alpha-p6-030 fills, its six criterion verdicts, the batch's attempts at
// a lead (alpha-p10-100), and the lead's current intent, priority and tier (gamma-p5-060). The model
// call's decision record is core/packages/ai's decision_records row, linked by id. A verdict links
// its snapshot by the pair (workspace_id, snapshot_id), so the database refuses a link across
// workspaces, and goes with it (ON DELETE CASCADE): the module's erasePerson deletes a person's
// snapshots. The criteria, verdicts and disqualifiers are the closed lists of the module's
// schemas/assess-fit.ts.

/// tenant
model ScoreSnapshot {
  id               String                      @id
  workspaceId      String                      @map("workspace_id")
  personId         String                      @map("person_id")
  /// The audience it was assessed against, icp's id (gamma-p5-050). Null only on a row of the
  /// previous release in a workspace without a default audience: read as the default.
  icpId            String?                     @map("icp_id")
  icpVersion       Int                         @map("icp_version")
  modelId          String                      @map("model_id")
  promptVersion    Int                         @map("prompt_version")
  /// The scorer that filled fit_score (alpha-p6-030); null until scored.
  scorerVersion    String?                     @map("scorer_version")
  /// 0 to 100; null until scored.
  fitScore         Int?                        @map("fit_score")
  confidence       ScoreConfidence?
  tier             ScoreTier?
  status           ScoreSnapshotStatus         @default(assessed)
  /// The codes the model found, each once; empty when none.
  disqualifiers    QualificationDisqualifier[]
  /// The model's one sentence about the fit; it may quote the profile.
  /// pii: business_contact
  summary          String
  /// The decision record of the model call (core/packages/ai).
  decisionRecordId String                      @map("decision_record_id")
  /// A re-score's copy (alpha-p6-040): the criteria it was scored with, hashed (their key, weight,
  /// must and enabled); empty for the assessment's own snapshot.
  criteriaHash     String                      @default("") @map("criteria_hash")
  /// The same hash of the criteria that scored it, empty until scored (alpha-p10-100): outside the
  /// key, so that a re-score with those criteria writes no copy of the assessment's own snapshot.
  scoredCriteriaHash String                    @default("") @map("scored_criteria_hash")
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  verdicts         CriterionVerdict[]

  @@unique([workspaceId, id])
  // One snapshot per decision record, audience, version and re-score's criteria: a retried activity,
  // which the record's cache answers, gets the stored one, and two audiences alike get one each.
  @@unique([workspaceId, decisionRecordId, icpId, icpVersion, criteriaHash])
  @@index([workspaceId, personId, createdAt])
  @@map("score_snapshots")
}

/// tenant
model CriterionVerdict {
  id          String                 @id
  workspaceId String                 @map("workspace_id")
  snapshotId  String                 @map("snapshot_id")
  criterion   QualificationCriterion
  /// The model's verdict; null on a row that holds a member's verdict only (lead-verdict-edit).
  verdict     QualificationVerdict?
  /// The model's quote or paraphrase of the profile, empty when unknown.
  /// pii: business_contact
  evidence    String
  /// The criterion's weight in the fit (alpha-p6-030); null until scored.
  weight      Int?
  /// The points the effective verdict earned (alpha-p6-030); null until scored.
  points      Decimal?               @db.Decimal(5, 2)
  /// A member's verdict (lead-verdict-edit), which counts instead of the model's while set.
  memberVerdict QualificationVerdict?  @map("member_verdict")
  /// The member's note on it, 500 characters at most; null without one.
  /// pii: business_contact
  memberNote  String?                @map("member_note")
  /// The member who set it (a user id) and when; null without a member's verdict.
  memberSetBy String?                @map("member_set_by")
  memberSetAt DateTime?              @map("member_set_at") @db.Timestamptz()
  snapshot    ScoreSnapshot          @relation(fields: [workspaceId, snapshotId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([workspaceId, snapshotId, criterion])
  @@map("criterion_verdicts")
}

/// tenant
/// The batch's attempt at a lead's assessment against one audience at one version (alpha-p10-100,
/// gamma-p5-050), in its reservation's key from the second: each release moves it, so a released key
/// is never reserved again; a provider failure at the third makes the lead ai_failed. No row is the
/// first attempt.
model AssessmentAttempt {
  workspaceId String @map("workspace_id")
  personId    String @map("person_id")
  /// The audience, icp's id (gamma-p5-050).
  icpId       String @map("icp_id")
  icpVersion  Int    @map("icp_version")
  /// The attempt the lead's next reservation is for, 2 or more.
  attempt     Int

  @@id([workspaceId, personId, icpId, icpVersion])
  @@map("assessment_attempts")
}

/// tenant
/// A lead's current intent, priority and tier (gamma-p5-060), one row per person, written with the
/// lead's tier and why by a decision, a re-score and the nightly decay. Ids, codes, numbers and
/// times only: the breakdown names each signal by its event id, never its words.
model IntentScore {
  workspaceId     String     @map("workspace_id")
  personId        String     @map("person_id")
  /// 0 to 100 (a hand-written CHECK of the migration qualification_intent_scores), from the signal
  /// reader's items under the scorer version.
  intentScore     Int        @map("intent_score")
  /// 0 to 100 (the same CHECK), from the lead's fit and the intent, the boost included.
  priority        Int
  /// The lead's tier from the priority; null for a lead without one (not_qualified).
  tier            ScoreTier?
  /// Each signal that counts: { eventId, kind, role, contribution, at, ownerUserId }, strongest
  /// first; `at` and `ownerUserId` (the source's creator) since gamma-p5-065.
  intentBreakdown Json       @map("intent_breakdown")
  /// The signal the why's why-now bullet names; null without one.
  whyNowEventId   String?    @map("why_now_event_id")
  /// When the boost ends; null when no signal boosts the priority.
  boostUntil      DateTime?  @map("boost_until") @db.Timestamptz()
  scorerVersion   String     @map("scorer_version")
  computedAt      DateTime   @map("computed_at") @db.Timestamptz()
  /// The Hot alert's claim (gamma-p5-065): set once per entry into Hot, before the mail; a write that
  /// takes the lead out of Hot clears it.
  hotAlertedAt    DateTime?  @map("hot_alerted_at") @db.Timestamptz()

  @@id([workspaceId, personId])
  @@map("intent_scores")
}

enum ScoreSnapshotStatus {
  assessed
  qualified
  not_qualified
  needs_review

  @@map("score_snapshot_status")
}

enum ScoreConfidence {
  high
  medium
  low

  @@map("score_confidence")
}

enum ScoreTier {
  hot
  warm
  cool

  @@map("score_tier")
}

enum QualificationCriterion {
  title_function
  seniority
  company_size
  industry
  location
  must_haves

  @@map("qualification_criterion")
}

enum QualificationVerdict {
  met
  partially_met
  not_met
  unknown

  @@map("qualification_verdict")
}

enum QualificationDisqualifier {
  competitor
  agency_or_consultant
  freelancer
  student_or_intern
  job_seeker
  recruiter
  wrong_business_model
  own_company
  existing_customer
  left_company
  fake_or_inactive_profile

  @@map("qualification_disqualifier")
}
