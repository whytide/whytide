// The datasource and the generator, once for the whole folder: Prisma assembles every *.prisma file
// here into one schema (docs/rules/coding.md §5). Models live in <module>.prisma, one file per module.
generator client {
  provider               = "prisma-client"
  output                 = "../../generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}
