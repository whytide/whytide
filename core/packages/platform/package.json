{
  "name": "@whytide/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Principal and permissions, credits client, events, config, ids, i18n runtime, egress client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./secrets/worker": {
      "types": "./dist/secrets/worker.d.ts",
      "default": "./dist/secrets/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "node ../../../tools/lint/lint.ts .",
    "test": "APP_ENV=test node --test tests/*.test.ts",
    "env:check": "node config/env-check.ts",
    "messages:check": "APP_ENV=test node i18n/messages-check.ts",
    "observability:check": "node telemetry/observability-check.ts",
    "secrets:keygen": "node secrets/keygen.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "intl-messageformat": "12.1.3",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
