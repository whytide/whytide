# Whytide environment: every variable with its default, one block per package and module, in
# module order (docs/rules/coding.md §8). Copy to .env.local at the repository root; .env.local is
# never committed (docs/rules/security.md §4). A task adds its variables to its block, nowhere else.

# ---- deploy ----
# The shared development stack (deploy/README.md): one Compose project per laptop, every port on
# 127.0.0.1. compose.yaml carries the same defaults; to move a port or change a password on a laptop,
# put the line in deploy/.env (git-ignored). The passwords are for that localhost-only stack and
# nothing else.
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_PASSWORD=whytide
DEV_REDIS_PORT=6379
DEV_TEMPORAL_PORT=7233
DEV_TEMPORAL_UI_PORT=8233
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_MINIO_ROOT_USER=whytide
DEV_MINIO_ROOT_PASSWORD=whytide-development
DEV_MAILPIT_PORT=1025
DEV_MAILPIT_UI_PORT=8025
DEV_OTEL_PORT=4318
DEV_OTEL_GRPC_PORT=4317
DEV_GRAFANA_PORT=3000
# The worktree's slice of that stack (deploy/README.md "One slice per worktree"): `pnpm env:create`
# writes .env.local from this file with these filled in from the running stack and the slice's name,
# and leaves every other variable at its default here. A value on a line that ends in `# secret` is
# an example and is never copied: env:create writes it empty, for the person to fill. The package
# that reads one of these may move it to its own block.
SLICE_NAME=

# ---- packages/platform ----
# Read by every host at start (core/packages/platform/README.md "Config"). APP_ENV is the
# environment the hosts run as, required: a shared or staging server runs development or
# production; test is for test processes on a laptop or in the pipeline only, never a server
# others reach. LOG_LEVEL is pino's level. OTEL_EXPORTER_OTLP_ENDPOINT is the collector's OTLP
# address: env:create fills it from the observability profile when that runs, and the hosts export
# nothing while it is empty. OTEL_SERVICE_NAME is each host's own, set in its code.
# DEFAULT_LOCALE is the locale when neither the user's setting nor the browser names one
# (core/packages/platform/README.md "Messages and the i18n runtime").
APP_ENV=development
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
DEFAULT_LOCALE=en
# EGRESS_ALLOW_HOSTS and EGRESS_DENY_HOSTS are the lists of the egress rules
# (core/packages/platform/README.md "Egress: what is refused"): comma-separated host or host:port
# entries. An entry names one exact host (no wildcards, no subdomains); one without a port opens
# every port of that host. An allow-listed host passes the port rule and, for a local test server,
# the address rule; the list is empty in production. A denied host is never fetched. A malformed
# entry stops the host at start, naming the variable.
EGRESS_ALLOW_HOSTS=
EGRESS_DENY_HOSTS=
# COST_PRICES_JSON is the price table recordCost fills unit_cost from (core/packages/platform/README.md
# "Cost events"): one JSON object with the list's version and, per vendor and model (`*` for prices
# that depend on no model), the price per unit kind in the list's currency. While it is empty no call
# can be priced.
COST_PRICES_JSON={"version":"2026-10-21","prices":{"example-llm":{"example-model":{"input_tokens":0.000003,"output_tokens":0.000015}},"example-pages":{"*":{"pages":0.002}},"fake":{"fake-model":{"input_tokens":0,"output_tokens":0}}}}
# The outbox (platform README "Events and the outbox"): attempts before a row is dead-lettered; the poll wait.
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_MS=1000
# The app master key of secrets at rest (core/packages/platform/README.md "Secrets at rest"): 32 bytes
# in base64, printed by `pnpm secrets:keygen`; a host without it starts and fails at its first
# secret. APP_MASTER_KEY_PREVIOUS is the key before a rotation, for decryption only; empty otherwise.
APP_MASTER_KEY= # secret
APP_MASTER_KEY_PREVIOUS= # secret
# fetchSafe's bounds for a call that names none (platform README "Egress: fetchSafe"): ms, at
# most 2147483647, and bytes, at most 268435456 (256 MiB).
EGRESS_DEFAULT_TIMEOUT_MS=10000
EGRESS_DEFAULT_MAX_BYTES=1048576

# ---- packages/db ----
# The three connection strings of core/packages/db (docs/rules/security.md §3): migrations run as the
# owner, the api and the worker connect as `app`, the seeder as `billing_writer`. `pnpm env:create`
# fills them with the slice's login roles and the stack's password (deploy/README.md).
DATABASE_URL_OWNER=postgresql://owner:whytide@127.0.0.1:5432/app # secret
DATABASE_URL=postgresql://app:whytide@127.0.0.1:5432/app # secret
DATABASE_URL_BILLING_WRITER=postgresql://billing_writer:whytide@127.0.0.1:5432/app # secret

# ---- packages/providers ----
# One PROVIDER_<PORT> per port names the adapter folder the port runs on, `fake` in development and
# tests, the vendor in production (core/packages/providers/README.md "A port"). A port task declares
# its own in `<port>/config.ts` through defineConfig("packages/providers", …) and adds the line here,
# at the end of this block, with the adapters' own variables after it.
# The app-mail port, the mail the app sends itself (core/packages/providers/app-mail/README.md).
PROVIDER_APP_MAIL=smtp
# The smtp adapter (app-mail/smtp/README.md): the relay, Mailpit's SMTP in development (env:create).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD= # secret
MAIL_FROM=no-reply@whytide.localhost
# readMailpit (app-mail/testing/), in tests only: Mailpit's API, filled in by env:create.
MAILPIT_API_URL=http://127.0.0.1:8025
# auth: the authentication port (core/packages/providers/auth/README.md): `better-auth`, or `fake`.
PROVIDER_AUTH=better-auth
# The better-auth adapter (auth/better-auth/README.md): the key that signs its session cookies, 32
# characters or more (empty outside production: a random key per process), and the origin the
# browser opens sign-in links on (empty: http://127.0.0.1:API_PORT). Both required in production.
AUTH_SECRET= # secret
AUTH_BASE_URL=
# The files port (core/packages/providers/files/README.md): `s3` on the shared stack's MinIO.
PROVIDER_FILES=s3
# Its s3 adapter (files/s3/README.md): the store's URL, the bucket and the credentials, all four
# filled by `pnpm env:create` for the slice, MinIO's root user in development.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=
S3_ACCESS_KEY=whytide
S3_SECRET_KEY=whytide-development # secret
# The LinkedIn port (core/packages/providers/linkedin/README.md): `fake`, or `unipile` on the vendor.
PROVIDER_LINKEDIN=fake
# The unipile adapter (linkedin/unipile/README.md): the account's API address and key, the secret of
# its account-status webhook, and the public URL of POST /v1/linkedin/webhooks/unipile.
UNIPILE_BASE_URL=
UNIPILE_API_KEY= # secret
UNIPILE_WEBHOOK_SECRET= # secret
UNIPILE_NOTIFY_URL=
# The key the unipile adapter signs its paging cursors with: at least 32 characters, required.
UNIPILE_CURSOR_SECRET= # secret
# The LLM port (core/packages/providers/llm/README.md): the adapter Mastra's models come from.
PROVIDER_LLM=fake
# The anthropic adapter (llm/anthropic/README.md): its key and the model it lists first.
LLM_ANTHROPIC_API_KEY= # secret
LLM_MODEL_DEFAULT=claude-opus-5-5
# The openai adapter (llm/openai/README.md): its key and every call's reasoning effort, none, low,
# medium, high, xhigh or max (none serves gpt-6-sol and gpt-6-luna only). With PROVIDER_LLM=openai,
# LLM_MODEL_DEFAULT above names one of its models: gpt-6.1-sol, its default, when empty.
LLM_OPENAI_API_KEY= # secret
LLM_OPENAI_REASONING_EFFORT=medium
# The mailbox port (core/packages/providers/mailbox/README.md): `fake`; empty, each mailbox's provider.
PROVIDER_MAILBOX=fake
# The alerts port (core/packages/providers/alerts/README.md): `webhook`; empty, no team channel.
PROVIDER_ALERTS=
# The webhook adapter (alerts/webhook/README.md): the team channel's incoming webhook URL.
ALERTS_WEBHOOK_URL= # secret
# The browser port (core/packages/providers/browser/README.md): `playwright` or `fake`; empty, none.
PROVIDER_BROWSER=fake
# The playwright adapter (browser/playwright/README.md): the browser service's endpoint in Compose.
BROWSER_WS_URL=ws://browser:3000/
# The company-data port (core/packages/providers/company-data/README.md): its adapters, in order.
PROVIDER_COMPANY_DATA=fake
# The companies-house adapter (company-data/companies-house/README.md): its REST key; no allowance.
COMPANIES_HOUSE_API_KEY= # secret
COMPANIES_HOUSE_ALLOWANCE=
# The diffbot adapter (company-data/diffbot/README.md): its token and its free plan's companies.
DIFFBOT_TOKEN= # secret
DIFFBOT_ALLOWANCE=400/month
# The google-kg adapter (company-data/google-kg/README.md): its API key and its free calls.
GOOGLE_KG_API_KEY= # secret
GOOGLE_KG_ALLOWANCE=100000/day
# The pdl adapter (company-data/pdl/README.md): its key, its free plan's enrichments, and the least
# likelihood of a match, 1 to 10.
PDL_API_KEY= # secret
PDL_ALLOWANCE=100/month
PDL_MIN_LIKELIHOOD=6
# The wikidata adapter (company-data/wikidata/README.md): the User-Agent's contact, required.
WIKIDATA_CONTACT=
WIKIDATA_ALLOWANCE=
# The owner's, for each adapter's live suite only: one company each may look up (its README).
# COMPANIES_HOUSE_TEST_NAME=
# DIFFBOT_TEST_NAME=
# DIFFBOT_TEST_DOMAIN=
# DIFFBOT_TEST_LINKEDIN_URL=
# GOOGLE_KG_TEST_NAME=
# PDL_TEST_NAME=
# PDL_TEST_DOMAIN=
# PDL_TEST_LINKEDIN_URL=
# WIKIDATA_TEST_NAME=
# WIKIDATA_TEST_DOMAIN=
# WIKIDATA_TEST_LINKEDIN_URL=
# The email-finder port (core/packages/providers/email-finder/README.md): its adapters, in order.
PROVIDER_EMAIL_FINDER=fake
# The hunter adapter (email-finder/hunter/README.md): its key and its free plan's credits.
HUNTER_API_KEY= # secret
HUNTER_ALLOWANCE=50/month
# The prospeo adapter (email-finder/prospeo/README.md): its key and its free plan's credits.
PROSPEO_API_KEY= # secret
PROSPEO_ALLOWANCE=75/month
# The snov adapter (email-finder/snov/README.md): its API id and secret, and its free plan's credits.
SNOV_CLIENT_ID= # secret
SNOV_CLIENT_SECRET= # secret
SNOV_ALLOWANCE=50/month
# The tomba adapter (email-finder/tomba/README.md): its key, its secret and its free plan's searches.
TOMBA_KEY= # secret
TOMBA_SECRET= # secret
TOMBA_ALLOWANCE=25/month
# The owner's, for each finder's live suite only: one person each may look up (its README).
# HUNTER_TEST_FIRST_NAME=
# HUNTER_TEST_LAST_NAME=
# HUNTER_TEST_DOMAIN=
# PROSPEO_TEST_FIRST_NAME=
# PROSPEO_TEST_LAST_NAME=
# PROSPEO_TEST_DOMAIN=
# SNOV_TEST_FIRST_NAME=
# SNOV_TEST_LAST_NAME=
# SNOV_TEST_DOMAIN=
# TOMBA_TEST_FIRST_NAME=
# TOMBA_TEST_LAST_NAME=
# TOMBA_TEST_DOMAIN=
# The email-verifier port (core/packages/providers/email-verifier/README.md): its adapters, in turn.
PROVIDER_EMAIL_VERIFIER=fake
# The web-search port (core/packages/providers/web-search/README.md): its adapters, in order.
PROVIDER_WEB_SEARCH=fake
# The brave adapter (web-search/brave/README.md): its key and its free searches. The live check's
# query, BRAVE_TEST_QUERY, is the owner's, set in their shell for that one run, never here.
BRAVE_API_KEY= # secret
BRAVE_ALLOWANCE=1000/month
# The email verifiers (email-verifier/<adapter>/README.md): each one's key, verifalia's user made
# with verification rights only, and each free plan's checks.
QUICKEMAILVERIFICATION_API_KEY= # secret
QUICKEMAILVERIFICATION_ALLOWANCE=100/day
MAILBOXVALIDATOR_API_KEY= # secret
MAILBOXVALIDATOR_ALLOWANCE=300/month
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD= # secret
VERIFALIA_ALLOWANCE=25/day
ZEROBOUNCE_API_KEY= # secret
ZEROBOUNCE_ALLOWANCE=100/month
REOON_API_KEY= # secret
REOON_ALLOWANCE=20/day
# The owner's, for each verifier's live suite only: one address the owner controls (its README).
# QUICKEMAILVERIFICATION_TEST_ADDRESS=
# MAILBOXVALIDATOR_TEST_ADDRESS=
# VERIFALIA_TEST_ADDRESS=
# ZEROBOUNCE_TEST_ADDRESS=
# REOON_TEST_ADDRESS=

# ---- packages/ai ----
# The days a decision record keeps its raw prompt and output (core/packages/ai/README.md "Decision
# records"); `pnpm -F ai purge-raw` nulls them after that.
AI_RAW_RETENTION_DAYS=30
# The schema of Mastra's storage (core/packages/ai/README.md "The Mastra instance"); the migration
# ai_mastra_schema creates `mastra` and lets `app` create in it.
MASTRA_SCHEMA=mastra
# 1 runs `pnpm -F ai eval` on the model PROVIDER_LLM names, at its price; 0 on the LLM fake with each
# case's scripted answers, as the pipeline does (core/packages/ai/README.md "Evals").
EVAL_LIVE=0

# ---- packages/ui ----

# ---- modules/tenancy ----
# The first organization and workspace, which `pnpm invite` makes on a database with none
# (core/modules/tenancy/README.md "Settings"): the name both take and the workspace's slug, 2 to 40
# lowercase letters, digits, dashes.
ORGANIZATION_NAME=My organization
WORKSPACE_SLUG=main
# Where testers give feedback: an https URL, linked as "Give feedback" from every page's header; empty
# for no link (core/modules/tenancy/README.md "Settings").
FEEDBACK_URL=

# ---- modules/identity ----
# The email `pnpm smoke` signs in with (core/modules/identity/README.md "The smoke test"); the smoke
# test invites it to the first workspace, and stops on a database with no organization: run
# `pnpm invite <email>` first, which makes it.
SMOKE_EMAIL=smoke@example.test
# The days an invite stays open after it is made or renewed, 1 or more, no maximum. Read at the
# api's start: a change needs an api and worker restart (core/modules/identity/README.md "Settings").
IDENTITY_INVITE_TTL_DAYS=7

# ---- modules/onboarding ----
# The pages a Draft from website reads, the home page included, 1 to 10 (core/modules/onboarding/
# README.md "The website fetch"), read at the worker's start.
ONBOARDING_FETCH_MAX_PAGES=5
# The drafter's model (core/modules/onboarding/agents/draft-company-knowledge/README.md), as the LLM
# port names it; empty, the port's first model, LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_ONBOARDING_DRAFT_COMPANY_KNOWLEDGE=
# The documents one Draft takes at most, then the bytes of one file at most (10 MB), each 1 or more,
# no maximum; more files can pass the api's 1 MB body or the drafter's budget. A change needs an api
# and worker restart (core/modules/onboarding/README.md "Settings").
ONBOARDING_MAX_FILES=5
ONBOARDING_MAX_FILE_BYTES=10485760

# ---- modules/icp ----
# The drafter's model (core/modules/icp/agents/draft-profile/README.md), as the LLM port names it;
# empty, the port's first model, LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_ICP_DRAFT_PROFILE=
# The audiences one workspace holds, its default included, 1 or more, no maximum; keep it at or
# above PLAYBOOKS_MAX_AGENTS_PER_WORKSPACE: each live agent needs an audience of its own. Read at
# the api's start: a change needs a restart (core/modules/icp/README.md "Settings").
ICP_MAX_AUDIENCES_PER_WORKSPACE=10

# ---- modules/playbooks ----
# The agents not archived in one workspace, then the sources one agent holds, each 1 or more, no
# maximum; keep SIGNALS_MAX_ENABLED_SOURCES at or above the second if all of an agent's sources
# should run. Read at the api's start: a change needs a restart (core/modules/playbooks/README.md
# "Settings").
PLAYBOOKS_MAX_AGENTS_PER_WORKSPACE=3
PLAYBOOKS_MAX_SOURCES_PER_AGENT=10

# ---- modules/signals ----
# The enabled sources of one agent at once, and of the sources in no agent: each group is counted
# on its own (core/modules/signals/README.md "Settings").
SIGNALS_MAX_ENABLED_SOURCES=10
# The pages a signal run started before beta-p1-090 reserves its credits for (README.md "Runs").
SIGNALS_ESTIMATED_PAGES=4
# How far back a post_engagers run reads a post's engagers, and how long after its save it runs, in
# days, 30 at most (sources/post_engagers/; README.md "Settings").
SIGNALS_POST_ENGAGERS_LOOKBACK_DAYS=30
# One engager's profile read, in credits, 0 to 100; credits' PRICE_SIGNALS_ENGAGER overrides it.
SIGNALS_CREDITS_PER_ENGAGER=1
# How far back a topic run, then an own-posts run reads posts, in days, 30 at most each (sources/).
SIGNALS_TOPIC_LOOKBACK_DAYS=14
SIGNALS_MY_POST_LOOKBACK_DAYS=30
# How far back a competitor run, then a creator run reads posts, in days, 30 at most each (sources/);
# then the enabled competitor and creator sources of one sender account (README.md "Settings").
SIGNALS_COMPETITOR_LOOKBACK_DAYS=14
SIGNALS_CREATOR_LOOKBACK_DAYS=14
SIGNALS_MAX_TRACKED_PER_ACCOUNT=10
# The rating agent's model (core/modules/signals/agents/rate-engagement/); empty, the port's first.
AI_MODEL_SIGNALS_RATE_ENGAGEMENT=
# The triage agent's model (core/modules/signals/agents/triage-engagers/); empty, the port's first.
AI_MODEL_SIGNALS_TRIAGE_ENGAGERS=
# The research plan agent's model (core/modules/signals/agents/research-plan/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_PLAN=
# The result-picking agent's model (core/modules/signals/agents/research-pick-results/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_PICK_RESULTS=
# The page-reading agent's model (core/modules/signals/agents/research-read-page/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_READ_PAGE=
# The company judge's model (core/modules/signals/agents/research-judge-company/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_JUDGE_COMPANY=
# The people agents' models (core/modules/signals/agents/research-read-people/ and research-pick-people/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_READ_PEOPLE=
AI_MODEL_SIGNALS_RESEARCH_PICK_PEOPLE=
# The reads of a LinkedIn account's quota day the sources never use, kept for the campaigns' checks
# before each send, then the most engagements one run sends to the AI for rating, each 1 or more, no
# maximum. A change needs an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_READS_KEPT_FOR_SENDS=20
SIGNALS_RATE_MAX_EVENTS_PER_RUN=100
# The days between two runs of a Web research source in an active agent, 1 or more, no maximum; a
# change needs an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_EVERY_DAYS=7
# The days a search a Web research source asked is not asked again, 1 or more, no maximum; a change
# needs an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_RECHECK_DAYS=180
# The searches one run of a Web research source asks at most, 1 or more, no maximum; a change needs
# an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_SEARCHES_PER_RUN=60
# The pages one run of a Web research source reads at most, 1 or more, no maximum; at it the run ends
# done; a change needs an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_PAGES_PER_RUN=40
# The companies one run of a Web research source judges at most, then the pages of one company's site
# it reads, each 1 or more, no maximum; at the first the run ends done and the candidates left wait for
# the next run; a change needs an api and worker restart (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_COMPANIES_PER_RUN=25
SIGNALS_RESEARCH_SITE_MAX_PAGES=5
# One company a research run reads and judges, in credits, 0 to 100, whatever the verdict; credits'
# PRICE_SIGNALS_RESEARCHED_COMPANY overrides it.
SIGNALS_CREDITS_PER_RESEARCHED_COMPANY=1
# The people taken from one found company of a Web research source at most, the best fits first, 1 to
# 10: a privacy cap, not a product limit; a change needs an api and worker restart
# (core/modules/signals/README.md "Settings").
SIGNALS_RESEARCH_PEOPLE_PER_COMPANY=3
# The result-reading agent's model (core/modules/signals/agents/research-read-result/); empty, the port's first.
AI_MODEL_SIGNALS_RESEARCH_READ_RESULT=

# ---- modules/qualification ----
# The assessment agent's model (core/modules/qualification/agents/assess-fit/README.md), as the LLM
# port names it; empty, the port's first model, LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_QUALIFICATION_ASSESS_FIT=
# The batch (core/modules/qualification/README.md "The batch"): the leads one batch reads, 1 to 500,
# and the minutes between two ticks of the schedule that starts every workspace's batch, 1 to 60.
QUALIFICATION_BATCH_SIZE=50
QUALIFICATION_SCHEDULE_MINUTES=2

# ---- modules/discovery ----
# The limits of an uploaded CSV (core/modules/discovery/README.md "POST …/imports"): its data rows,
# the header aside, at most 50,000, and its bytes, at most the files port's 25 MiB; the next row or
# byte stops it. A file with a valid row also needs contacts' HASH_SALT, below.
IMPORT_MAX_ROWS=5000
IMPORT_MAX_BYTES=5242880

# ---- modules/contacts ----
# The key of the person hashes (core/modules/contacts/README.md "Settings"): 32 characters or more,
# such as `openssl rand -base64 32`, kept for good, since another key no longer matches an erased
# person's hash. Empty, a host starts and the first upsert or hash check fails with hash_salt_missing.
HASH_SALT= # secret
# An exclusion list's CSV, at most: its data rows (1 to 10,000) and its bytes (5 MiB at most).
EXCLUSIONS_IMPORT_MAX_ROWS=5000
EXCLUSIONS_IMPORT_MAX_BYTES=1048576
# Minutes a new lead waits for enrichment before its first judgement (0 to 1,440; 0 is no hold).
CONTACTS_ENRICHMENT_HOLD_MINUTES=60
# The source classes whose company facts every organization reads (open_data, website, web_search,
# data_vendor; core/modules/contacts/README.md "Shared companies"); empty, no fact is shared.
CONTACTS_SHARED_FACT_SOURCES=open_data,website
# Days after a person's last touch before a new campaign may reach them again, 1 or more, no maximum
# (core/modules/contacts/README.md "Settings"). Send safety: lowering it lets the same person be
# contacted again sooner. Read at the start: a change needs an api and worker restart.
CONTACTS_RECENT_TOUCH_DAYS=90

# ---- modules/messaging ----
# The most characters of a connection request's note (core/modules/messaging/README.md "Settings"),
# 1 to 300: LinkedIn's limit is 200, or 300 with a paid plan. A message keeps to 150 to 300.
LINKEDIN_NOTE_LIMIT=200
# The writer's two models (core/modules/messaging/agents/plan-message/README.md and
# write-message/README.md), as the LLM port names them; empty, the port's first model,
# LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_MESSAGING_PLAN_MESSAGE=
AI_MODEL_MESSAGING_WRITE_MESSAGE=
# The email writer's model (core/modules/messaging/agents/write-email/README.md); empty, the port's first.
AI_MODEL_MESSAGING_WRITE_EMAIL=
# The inbox's reply writer's model (core/modules/messaging/agents/write-reply/README.md); empty, the port's first.
AI_MODEL_MESSAGING_WRITE_REPLY=

# ---- modules/linkedin ----
# The highest daily read cap an owner may set, 1 to 100 (core/modules/linkedin/README.md "Settings"):
# an existing .env above 100 must come down to 100 before the upgrade, or the start fails.
LINKEDIN_DAILY_READ_CAP_MAX=100
# The member id's hash key, 32 characters or more, kept for good; empty: no account can send.
LINKEDIN_HASH_KEY= # secret
# The operator's address for the fleet breaker's mail (core/modules/linkedin/docs/runbook.md); empty: a log line instead.
LINKEDIN_ALERT_EMAIL=
# The most company page reads an account makes a day for enrichment, 0 to 100, inside its daily
# reads (core/modules/linkedin/README.md "Read quota"); 0: none.
LINKEDIN_COMPANY_READS_PER_DAY=20
# LinkedIn's "Contact info" emails for an email lookup (core/modules/linkedin/README.md "Contact
# info"): false by default; the owner's exception of 2026-11-13, for now. Off stops new reads only.
LINKEDIN_CONTACT_INFO_ENABLED=false
# Invitations with a note one account sends in 30 days, 1 or more, no maximum
# (core/modules/linkedin/README.md "Settings"). 3 is LinkedIn's limit for a free account: raise it
# only for a paid plan. Read at the start: a change needs an api and worker restart.
LINKEDIN_INVITE_NOTES_PER_MONTH=3

# ---- modules/credits ----
# The fixed plan the seeder writes as billing_writer at the api's start and on `pnpm credits:seed`
# (core/modules/credits/README.md "The seeder"): its code and the credits it grants each month. A new
# value takes effect at the next start, for the next period (core/modules/credits/docs/runbook.md).
CREDITS_MONTHLY_ALLOWANCE=10000000
CREDITS_PLAN_CODE=self_hosted
# A price override per priced action, read at the api's start (core/modules/credits/README.md
# "Declaring a price"): PRICE_ and the action in upper case, `.` written `_`, set to a decimal of 0 or
# more; a malformed one stops the start. For example: PRICE_QUALIFICATION_ASSESSMENT=0.5
# The credit alerts' thresholds, whole percents of a period's granted credits from 1 to 100, separated
# by commas, each once; then the days a price rise is announced before it applies, 1 or more, no
# maximum. A change needs an api and worker restart (core/modules/credits/README.md "Settings").
CREDITS_ALERT_THRESHOLDS=80,95,100
CREDITS_PRICE_CHANGE_NOTICE_DAYS=30

# ---- modules/campaigns ----
# A send, an invite or a message, in credits, 0 to 100; PRICE_CAMPAIGNS_LINKEDIN_SEND overrides it.
CAMPAIGNS_CREDITS_PER_LINKEDIN_SEND=1
# Whole numbers, no maximum (core/modules/campaigns/README.md "Settings"); read at the start, so a
# change needs an api and worker restart. A later step's longest delay after the step before, in
# business days, 5 or more (the built-in sequences' longest delay).
CAMPAIGNS_MAX_STEP_DELAY_BUSINESS_DAYS=30
# After a "not interested" reply, the days before the person can be enrolled again, 1 or more; after
# a "not now" reply, the days until the owner's reminder, 1 or more.
CAMPAIGNS_NOT_INTERESTED_COOL_DOWN_DAYS=180
CAMPAIGNS_NOT_NOW_REMINDER_DAYS=30
# An out-of-office reply: the days it pauses the campaign without a return date, 1 or more, and the
# business days after a return date it resumes, 0 or more (0, on the return date).
CAMPAIGNS_OOO_DEFAULT_PAUSE_DAYS=7
CAMPAIGNS_OOO_RESUME_BUSINESS_DAYS=1

# ---- modules/approvals ----
# The approval queue (core/modules/approvals/README.md "Settings"), read at the start, so a change
# needs an api and worker restart: the days a pending item waits before it needs attention and the
# hours ahead a due step joins the queue, each 1 or more, no maximum; then the edit ratio still
# counted a small edit in the report, above 0 and at most 1.
APPROVALS_NEEDS_ATTENTION_AFTER_DAYS=3
APPROVALS_QUEUE_WINDOW_HOURS=24
APPROVALS_SMALL_EDIT_MAX_RATIO=0.2

# ---- modules/inbox ----
# The reply classifier's model (core/modules/inbox/agents/classify-reply/README.md); empty, the port's
# first, LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_INBOX_CLASSIFY_REPLY=
# A reply classified below this confidence is only suggested, and nothing acts on it until a person
# confirms it; above 0 and at most 1 (core/modules/inbox/README.md "Settings"). Read at the start:
# a change needs an api and worker restart.
INBOX_CLASSIFY_SUGGEST_BELOW=0.7

# ---- modules/enrichment ----
# The sources asked for a new lead's company and person, in order, names separated by commas
# (core/modules/enrichment/README.md "How it works"): `company-data` asks PROVIDER_COMPANY_DATA's
# adapters in that list's order; `linkedin` reads the company's LinkedIn page through one of the
# workspace's accounts. Empty, `company-data` for the company and none for the person. A name
# that cannot run is left out at start with a warning (core/modules/enrichment/docs/runbook.md).
ENRICHMENT_COMPANY_SOURCES=linkedin,company-data
ENRICHMENT_PERSON_SOURCES=
# Minutes between two ticks (1 to 60), the held leads one batch takes (1 to 100), and the days a
# company enriched for a new lead is not asked again for the next one (1 to 365).
ENRICHMENT_TICK_MINUTES=5
ENRICHMENT_BATCH_SIZE=20
ENRICHMENT_COMPANY_RETRY_DAYS=30
# The website source (core/modules/enrichment/README.md "The source `website`"): the pages it reads of
# a company's site at most, the home page included (1 to 10), and the model of its AI task
# enrichment.read-company-site, empty for the LLM adapter's default.
ENRICHMENT_SITE_MAX_PAGES=5
AI_MODEL_ENRICHMENT_READ_COMPANY_SITE=
# The country namer's model, the source country-ai's (core/modules/enrichment/agents/name-country/
# README.md); empty, the port's first, LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_ENRICHMENT_NAME_COUNTRY=
# The email lookup (core/modules/enrichment/README.md "Email lookups"): the credits a verified address
# costs (0 to 100), the email sources in order (`email-finder` asks PROVIDER_EMAIL_FINDER's adapters in
# that list's order; empty, `email-finder`), and the most candidates one lookup verifies (1 to 5).
ENRICHMENT_CREDITS_PER_EMAIL=1
ENRICHMENT_EMAIL_SOURCES=email-finder
ENRICHMENT_EMAIL_MAX_CANDIDATES=3
# Personal addresses for leads in the UK, the EU or the EEA, or with no known country: false by the
# owner's decision of 2026-11-13, since there a cold email to a personal address needs the person's
# consent. Off, they are not used; nothing is deleted, so switching it on uses them again.
ENRICHMENT_PERSONAL_EMAIL_EU_UK=false
# Days until a company's fact is asked again by its next run (0 to 3,650; 0, never).
ENRICHMENT_FACT_DAYS=180
# The days a verified address is trusted before it is checked again, then the days after a lookup
# that found none before that person is looked up again, each 1 or more, no maximum. The first comes
# from the research rules (RB-7.3.3): lowering it costs more paid checks, raising it trusts older
# addresses. A change needs an api and worker restart (core/modules/enrichment/README.md "Settings").
ENRICHMENT_EMAIL_VALID_DAYS=120
ENRICHMENT_EMAIL_NOT_FOUND_RETRY_DAYS=30
# An email lookup asked for each lead a research source finds, with the address a page printed with
# the person verified first (core/modules/enrichment/README.md "Settings"): true or false. Off, none
# is asked and a printed address stays the person's key only.
ENRICHMENT_LOOKUP_AT_FIND=true

# ---- apps/api ----
# The api host (core/apps/api/README.md "Configuration"): API_PORT is the port it listens on, filled
# per worktree by `pnpm env:create`; API_PUBLIC_URL is the URL it is reached at from outside, empty
# for http://127.0.0.1:API_PORT.
API_PORT=3001
API_PUBLIC_URL=
# The request protections (core/apps/api/docs/security.md): REDIS_URL and REDIS_PREFIX, which
# `pnpm env:create` fills per worktree, hold the rate limits' windows; the limits a minute, per
# workspace, per client address on the authentication routes and per client address on a module's
# webhook route; the origins a request with the session cookie may change something from:
# APP_PUBLIC_ORIGIN, the web app's, and WEB_DEV_ORIGIN, the web's development server, read under
# APP_ENV=development only.
REDIS_URL=redis://127.0.0.1:6379 # secret
REDIS_PREFIX=
RATE_LIMIT_WORKSPACE_PER_MIN=600
RATE_LIMIT_AUTH_PER_IP_PER_MIN=20
RATE_LIMIT_WEBHOOK_PER_IP_PER_MIN=120
APP_PUBLIC_ORIGIN=
WEB_DEV_ORIGIN=
# TRUST_PROXY, Express's `trust proxy`: the proxies whose X-Forwarded-For names the client, as names
# (loopback, linklocal, uniquelocal) or addresses, comma-separated; production trusts Caddy's alone.
TRUST_PROXY=loopback,linklocal,uniquelocal

# ---- apps/worker ----
# The worker host (core/apps/worker/README.md "Configuration"): TEMPORAL_ADDRESS and
# TEMPORAL_NAMESPACE are the Temporal server and namespace, filled per worktree by
# `pnpm env:create`; WORKER_HEALTH_PORT is the port of GET /health, on 127.0.0.1 only;
# WORKER_SCHEDULES=off makes the modules' schedules paused at start, `on` resumes them.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
WORKER_HEALTH_PORT=3002
WORKER_SCHEDULES=on
# The minutes within which an alert of the same key is counted, not sent to the team channel again
# (core/apps/worker/README.md "Alerts"), 1 or more, no maximum; a change needs a worker restart.
ALERTS_REPEAT_MINUTES=15

# ---- apps/web ----
# The web host (core/apps/web/README.md "Run"): WEB_PORT is the port `pnpm -F web dev` and `start`
# listen on, at 127.0.0.1, filled per worktree by `pnpm env:create`, which also sets the api's
# WEB_DEV_ORIGIN to http://127.0.0.1:WEB_PORT; NEXT_PUBLIC_API_URL is the api the web's server calls
# and its /api rewrite reaches, empty for http://127.0.0.1:API_PORT.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=
