{
  "uid": "whytide-credits",
  "title": "Whytide credits",
  "description": "Credit usages by outcome, and the reservations refused for insufficient credits (core/modules/credits/docs/runbook.md)",
  "tags": ["whytide"],
  "schemaVersion": 41,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Usages, by outcome",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(credits_usage_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reservations refused, insufficient credits",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(credits_usage_total{outcome=\"insufficient\"}[$__rate_interval]))",
          "legendFormat": "insufficient"
        }
      ]
    }
  ]
}
