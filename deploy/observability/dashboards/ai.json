{
  "uid": "whytide-ai",
  "title": "Whytide AI calls",
  "description": "Agent calls by task: outcomes, the ai_failed rate, retries, tokens and cost (deploy/docs/observability.md)",
  "tags": ["whytide"],
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Calls, by task and outcome",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, outcome) (increase(ai_calls_total[$__rate_interval]))",
          "legendFormat": "{{task}} {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ai_failed rate over the last hour, by task",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(ai_calls_total{outcome=\"ai_failed\"}[1h])) / sum by (task) (increase(ai_calls_total{outcome!=\"cached\"}[1h]))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries, by task",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(ai_retries_total[$__rate_interval]))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens, by task and kind",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, kind) (increase(ai_tokens_total[$__rate_interval]))",
          "legendFormat": "{{task}} {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost per task, in the price list's currency",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(ai_cost_total[$__rate_interval]))",
          "legendFormat": "{{task}}"
        }
      ]
    }
  ]
}
