{
  "uid": "whytide-signals",
  "title": "Whytide signal runs",
  "description": "Signal runs by outcome and failure code, and the candidates they staged by kind (core/modules/signals/docs/runbook.md)",
  "tags": ["whytide"],
  "schemaVersion": 41,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Runs ended, by outcome and code",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, code) (increase(signals_runs_total[$__rate_interval]))",
          "legendFormat": "{{outcome}} {{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Candidates staged, by kind",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(signals_candidates_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
