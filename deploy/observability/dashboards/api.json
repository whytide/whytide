{
  "uid": "whytide-api",
  "title": "Whytide api",
  "description": "The api host: requests, latency, errors by code, rate-limit hits (deploy/docs/observability.md)",
  "tags": ["whytide"],
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second, by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(api_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95, by route",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(api_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors per second, by code",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, code) (rate(api_requests_total{code!=\"none\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate-limit hits per second, by kind",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(api_rate_limit_decisions_total{outcome!=\"allowed\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    }
  ]
}
