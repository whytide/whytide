# Whytide on one server (README.md "Production"): copy to deploy/.env on the server, write a secret
# between the quotes of every line that ends in `# secret`, put your domain and mail relay in place
# of the example.com names, then run `pnpm deploy:check`. Compose reads this file for compose.yaml's
# own variables, and the api and the worker get it whole as their environment; the web gets none of
# it. Compose reads `KEY= # note` as the value `# note`, so a comment never follows a bare `=`. The
# blocks are those of .env.example; what only development reads is left out. Never commit the copy.

# ---- deploy ----
# compose.yaml's own: the profile that starts the apps and Caddy with the state services.
COMPOSE_PROFILES=production
# The app's public name: its DNS record points at this server, whose ports 80 and 443 are open, and
# Caddy gets its certificate from Let's Encrypt. CADDY_INTERNAL_TLS=1 has Caddy's own authority sign
# it instead, for the test run only; deploy:check refuses it.
APP_DOMAIN=whytide.example.com
CADDY_INTERNAL_TLS=0
# Where Caddy publishes its ports: a port, or address:port.
CADDY_HTTP_PUBLISH=80
CADDY_HTTPS_PUBLISH=443
# The images of the api, the worker and the web, <registry>/<app>:<tag>, tagged with a commit by
# images:build.
IMAGE_REGISTRY=localhost/whytide
IMAGE_TAG=
# The network between Caddy and the apps, <prefix>.0/28; change it if it meets one of the server's.
EDGE_PREFIX=192.168.255
# The state services, under their development names: Postgres's superuser password, MinIO's root user
# (the apps' store user too, until a user limited to the bucket), and their ports on 127.0.0.1.
DEV_POSTGRES_PASSWORD="" # secret
DEV_MINIO_ROOT_USER=whytide
DEV_MINIO_ROOT_PASSWORD="" # secret
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_TEMPORAL_PORT=7233
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001

# ---- packages/platform ----
APP_ENV=production
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
DEFAULT_LOCALE=en
EGRESS_ALLOW_HOSTS=
EGRESS_DENY_HOSTS=
# The prices of the models in use (core/packages/platform/README.md "Cost events").
COST_PRICES_JSON={"version":"2026-10-21","prices":{"example-llm":{"example-model":{"input_tokens":0.000003,"output_tokens":0.000015}},"example-pages":{"*":{"pages":0.002}},"fake":{"fake-model":{"input_tokens":0,"output_tokens":0}}}}
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_MS=1000
# `pnpm secrets:keygen` prints one; keep a copy outside the server, or the secrets at rest are lost.
# APP_MASTER_KEY_PREVIOUS is the key before a rotation, for decryption only; empty otherwise.
APP_MASTER_KEY="" # secret
APP_MASTER_KEY_PREVIOUS=
EGRESS_DEFAULT_TIMEOUT_MS=10000
EGRESS_DEFAULT_MAX_BYTES=1048576

# ---- packages/db ----
# Three URLs to the database app at postgres:5432, each with a role of its own and its password, which
# postgres-setup creates: the owner, the apps' role and the seeder's, whytide_owner, whytide_app and
# whytide_billing_writer for example, each password 16 or more letters and digits (openssl rand -hex 24).
DATABASE_URL_OWNER="" # secret
DATABASE_URL="" # secret
DATABASE_URL_BILLING_WRITER="" # secret

# ---- packages/providers ----
PROVIDER_APP_MAIL=smtp
# Your mail relay: 465 is TLS from the start, another port STARTTLS, required with a user. Its login,
# SMTP_USER and SMTP_PASSWORD, both or neither.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@whytide.example.com
PROVIDER_AUTH=better-auth
# 32 characters or more; the origin the sign-in links open on, https://APP_DOMAIN.
AUTH_SECRET="" # secret
AUTH_BASE_URL=https://whytide.example.com
PROVIDER_FILES=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=whytide
# compose.yaml passes MinIO's root user to the apps for these two.
S3_ACCESS_KEY=
S3_SECRET_KEY=
PROVIDER_LINKEDIN=unipile
UNIPILE_BASE_URL=
UNIPILE_API_KEY="" # secret
UNIPILE_WEBHOOK_SECRET="" # secret
UNIPILE_NOTIFY_URL=https://whytide.example.com/v1/linkedin/webhooks/unipile
# The key the unipile adapter signs its paging cursors with: at least 32 characters, required.
UNIPILE_CURSOR_SECRET="" # secret
PROVIDER_LLM=anthropic
LLM_ANTHROPIC_API_KEY="" # secret
LLM_MODEL_DEFAULT=claude-opus-5-5
# With PROVIDER_LLM=openai: its key, and LLM_MODEL_DEFAULT one of its models, gpt-6.1-sol by default.
LLM_OPENAI_API_KEY="" # secret
LLM_OPENAI_REASONING_EFFORT=medium
# The mailbox port (core/packages/providers/mailbox/README.md): empty, each mailbox's own provider.
PROVIDER_MAILBOX=
# The alerts port: `webhook` with your team channel's incoming webhook URL; empty, no alerts.
PROVIDER_ALERTS=
ALERTS_WEBHOOK_URL="" # secret
# The browser port: `playwright` needs the browser service, COMPOSE_PROFILES=production,browser above
# (README.md "The browser service"); without it, enrichment keeps the plain fetch's page.
PROVIDER_BROWSER=playwright
BROWSER_WS_URL=ws://browser:3000/
# The company-data port: its adapters, in order; drop one without its key or contact; empty, none.
PROVIDER_COMPANY_DATA=wikidata,companies-house,google-kg,diffbot,pdl
# The companies-house adapter: its REST key; no allowance.
COMPANIES_HOUSE_API_KEY="" # secret
COMPANIES_HOUSE_ALLOWANCE=
# The diffbot adapter: its token and its free plan's companies.
DIFFBOT_TOKEN="" # secret
DIFFBOT_ALLOWANCE=400/month
# The google-kg adapter: its API key and its free calls.
GOOGLE_KG_API_KEY="" # secret
GOOGLE_KG_ALLOWANCE=100000/day
# The pdl adapter: its key, its free plan's enrichments, the least likelihood of a match, 1 to 10.
PDL_API_KEY="" # secret
PDL_ALLOWANCE=100/month
PDL_MIN_LIKELIHOOD=6
# The wikidata adapter: an email address or an https page where Wikimedia can reach you.
WIKIDATA_CONTACT=
WIKIDATA_ALLOWANCE=
# The email-finder port: its adapters, in order; drop one whose key you lack; empty, none.
PROVIDER_EMAIL_FINDER=hunter,tomba,prospeo,snov
# The hunter adapter: its key and its free plan's credits.
HUNTER_API_KEY="" # secret
HUNTER_ALLOWANCE=50/month
# The prospeo adapter: its key and its free plan's credits; drop it from the list if your plan has no API.
PROSPEO_API_KEY="" # secret
PROSPEO_ALLOWANCE=75/month
# The snov adapter: its API id and secret, and its free plan's credits; drop it if your plan has no API.
SNOV_CLIENT_ID="" # secret
SNOV_CLIENT_SECRET="" # secret
SNOV_ALLOWANCE=50/month
# The tomba adapter: its key, its secret and its free plan's searches.
TOMBA_KEY="" # secret
TOMBA_SECRET="" # secret
TOMBA_ALLOWANCE=25/month
# The email-verifier port: its adapters, in their turns; drop one whose key you lack; empty, none.
PROVIDER_EMAIL_VERIFIER=quickemailverification,mailboxvalidator,verifalia,zerobounce,reoon
# The web-search port: `brave` with its key and your plan's free searches; empty, no web search.
PROVIDER_WEB_SEARCH=brave
BRAVE_API_KEY="" # secret
BRAVE_ALLOWANCE=1000/month
# The email verifiers: each one's key, verifalia's user with verification rights only, and each
# free plan's checks; a verifier without its credentials fails the start, so drop it from the list.
QUICKEMAILVERIFICATION_API_KEY="" # secret
QUICKEMAILVERIFICATION_ALLOWANCE=100/day
MAILBOXVALIDATOR_API_KEY="" # secret
MAILBOXVALIDATOR_ALLOWANCE=300/month
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD="" # secret
VERIFALIA_ALLOWANCE=25/day
ZEROBOUNCE_API_KEY="" # secret
ZEROBOUNCE_ALLOWANCE=100/month
REOON_API_KEY="" # secret
REOON_ALLOWANCE=20/day

# ---- packages/ai ----
AI_RAW_RETENTION_DAYS=30
MASTRA_SCHEMA=mastra
EVAL_LIVE=0

# ---- modules/tenancy ----
ORGANIZATION_NAME=My organization
WORKSPACE_SLUG=main
# Where testers give feedback, an https URL linked from every page's header; empty for no link.
FEEDBACK_URL=

# ---- modules/identity ----
# The days an invite stays open after it is made or renewed, 1 or more.
IDENTITY_INVITE_TTL_DAYS=7

# ---- modules/onboarding ----
ONBOARDING_FETCH_MAX_PAGES=5
# An agent's model, here and in the blocks below, as the LLM port names it; empty, the port's first,
# LLM_MODEL_DEFAULT for anthropic.
AI_MODEL_ONBOARDING_DRAFT_COMPANY_KNOWLEDGE=
# The documents one Draft takes at most, then one file's bytes at most (10 MB), each 1 or more, no
# maximum; a change needs an api and worker restart.
ONBOARDING_MAX_FILES=5
ONBOARDING_MAX_FILE_BYTES=10485760

# ---- modules/icp ----
AI_MODEL_ICP_DRAFT_PROFILE=
# The audiences one workspace holds, its default included, 1 or more; at or above the agents' limit.
ICP_MAX_AUDIENCES_PER_WORKSPACE=10

# ---- modules/playbooks ----
# The agents not archived in one workspace, then the sources one agent holds, each 1 or more.
PLAYBOOKS_MAX_AGENTS_PER_WORKSPACE=3
PLAYBOOKS_MAX_SOURCES_PER_AGENT=10

# ---- modules/signals ----
SIGNALS_MAX_ENABLED_SOURCES=10
SIGNALS_ESTIMATED_PAGES=4
SIGNALS_POST_ENGAGERS_LOOKBACK_DAYS=30
# One engager's profile read, in credits, 0 to 100; credits' PRICE_SIGNALS_ENGAGER overrides it.
SIGNALS_CREDITS_PER_ENGAGER=1
# How far back a topic run, then an own-posts run reads posts, in days, 30 at most each.
SIGNALS_TOPIC_LOOKBACK_DAYS=14
SIGNALS_MY_POST_LOOKBACK_DAYS=30
# How far back a competitor run, then a creator run reads posts, in days, 30 at most each; then the
# enabled competitor and creator sources of one sender account.
SIGNALS_COMPETITOR_LOOKBACK_DAYS=14
SIGNALS_CREATOR_LOOKBACK_DAYS=14
SIGNALS_MAX_TRACKED_PER_ACCOUNT=10
# The rating agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RATE_ENGAGEMENT=
# The triage agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_TRIAGE_ENGAGERS=
# The research plan agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_PLAN=
# The result-picking agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_PICK_RESULTS=
# The page-reading agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_READ_PAGE=
# The company judge's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_JUDGE_COMPANY=
# The people agents' models, as the LLM port names them; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_READ_PEOPLE=
AI_MODEL_SIGNALS_RESEARCH_PICK_PEOPLE=
# The reads of an account's quota day kept for the send path's checks, then the most engagements one
# run rates, each 1 or more, no maximum; a change needs an api and worker restart.
SIGNALS_READS_KEPT_FOR_SENDS=20
SIGNALS_RATE_MAX_EVENTS_PER_RUN=100
# The days between two runs of a Web research source in an active agent, 1 or more, no maximum.
SIGNALS_RESEARCH_EVERY_DAYS=7
# The days a search a Web research source asked is not asked again, 1 or more, no maximum.
SIGNALS_RESEARCH_RECHECK_DAYS=180
# The searches one run of a Web research source asks at most, 1 or more, no maximum.
SIGNALS_RESEARCH_SEARCHES_PER_RUN=60
# The pages one run of a Web research source reads at most, 1 or more, no maximum.
SIGNALS_RESEARCH_PAGES_PER_RUN=40
# The companies one run of a Web research source judges at most, then the pages of one company's site
# it reads, each 1 or more, no maximum.
SIGNALS_RESEARCH_COMPANIES_PER_RUN=25
SIGNALS_RESEARCH_SITE_MAX_PAGES=5
# One company a research run reads and judges, in credits, 0 to 100, whatever the verdict; credits'
# PRICE_SIGNALS_RESEARCHED_COMPANY overrides it.
SIGNALS_CREDITS_PER_RESEARCHED_COMPANY=1
# The people taken from one found company at most, 1 to 10: a privacy cap.
SIGNALS_RESEARCH_PEOPLE_PER_COMPANY=3
# The result-reading agent's model, as the LLM port names it; empty, the port's first model.
AI_MODEL_SIGNALS_RESEARCH_READ_RESULT=

# ---- modules/qualification ----
AI_MODEL_QUALIFICATION_ASSESS_FIT=
QUALIFICATION_BATCH_SIZE=50
QUALIFICATION_SCHEDULE_MINUTES=2

# ---- modules/discovery ----
IMPORT_MAX_ROWS=5000
IMPORT_MAX_BYTES=5242880

# ---- modules/contacts ----
# The key of the person hashes, 32 characters or more (openssl rand -base64 32), kept for good:
# another key no longer matches an erased person's hash.
HASH_SALT="" # secret
# An exclusion list's CSV, at most: its data rows (1 to 10,000) and its bytes (5 MiB at most).
EXCLUSIONS_IMPORT_MAX_ROWS=5000
EXCLUSIONS_IMPORT_MAX_BYTES=1048576
# Minutes a new lead waits for enrichment before its first judgement (0 to 1,440; 0 is no hold).
CONTACTS_ENRICHMENT_HOLD_MINUTES=60
# The source classes whose company facts every organization reads; empty, no fact is shared.
CONTACTS_SHARED_FACT_SOURCES=open_data,website
# Days after a person's last touch before a new campaign may reach them again, 1 or more. Send
# safety: lowering it lets the same person be contacted again sooner. A change needs a restart.
CONTACTS_RECENT_TOUCH_DAYS=90

# ---- modules/messaging ----
# A connection request's note, at most: LinkedIn's limit is 200 characters, 300 with a paid plan.
LINKEDIN_NOTE_LIMIT=200
AI_MODEL_MESSAGING_PLAN_MESSAGE=
AI_MODEL_MESSAGING_WRITE_MESSAGE=
# The email writer's model (core/modules/messaging/agents/write-email/README.md); empty, the port's first.
AI_MODEL_MESSAGING_WRITE_EMAIL=
# The inbox's reply writer's model (core/modules/messaging/agents/write-reply/README.md); empty, the port's first.
AI_MODEL_MESSAGING_WRITE_REPLY=

# ---- modules/linkedin ----
# The highest daily read cap, 1 to 100: an existing .env above 100 must come down to 100 before the
# upgrade, or the start fails.
LINKEDIN_DAILY_READ_CAP_MAX=100
# The member id's hash key, 32 characters or more, kept for good; empty: no account can send.
LINKEDIN_HASH_KEY="" # secret
# The operator's address for the fleet breaker's mail; empty: a log line instead.
LINKEDIN_ALERT_EMAIL=
# The most company page reads an account makes a day for enrichment, 0 to 100, inside its daily reads.
LINKEDIN_COMPANY_READS_PER_DAY=20
# "Contact info" emails for an email lookup: false, the owner's exception of 2026-11-13, for now.
LINKEDIN_CONTACT_INFO_ENABLED=false
# Invitations with a note one account sends in 30 days, 1 or more. 3 is LinkedIn's limit for a free
# account: raise it only for a paid plan. A change needs an api and worker restart.
LINKEDIN_INVITE_NOTES_PER_MONTH=3

# ---- modules/credits ----
CREDITS_MONTHLY_ALLOWANCE=10000000
CREDITS_PLAN_CODE=self_hosted
# The alerts' thresholds, whole percents from 1 to 100, each once; the days a price rise is announced.
CREDITS_ALERT_THRESHOLDS=80,95,100
CREDITS_PRICE_CHANGE_NOTICE_DAYS=30

# ---- modules/campaigns ----
# A send, an invite or a message, in credits, 0 to 100; PRICE_CAMPAIGNS_LINKEDIN_SEND overrides it.
CAMPAIGNS_CREDITS_PER_LINKEDIN_SEND=1
# Whole numbers, no maximum; a change needs an api and worker restart. A later step's longest delay,
# in business days, 5 or more; the cool-down after "not interested" and the reminder after "not
# now", in days; an out-of-office pause without a return date, in days, and the business days after
# a return date the campaign resumes, 0 or more.
CAMPAIGNS_MAX_STEP_DELAY_BUSINESS_DAYS=30
CAMPAIGNS_NOT_INTERESTED_COOL_DOWN_DAYS=180
CAMPAIGNS_NOT_NOW_REMINDER_DAYS=30
CAMPAIGNS_OOO_DEFAULT_PAUSE_DAYS=7
CAMPAIGNS_OOO_RESUME_BUSINESS_DAYS=1

# ---- modules/approvals ----
# Days before a pending item needs attention and hours ahead a due step joins the queue, 1 or more;
# the edit ratio still counted small, above 0 and at most 1. A change needs an api and worker
# restart.
APPROVALS_NEEDS_ATTENTION_AFTER_DAYS=3
APPROVALS_QUEUE_WINDOW_HOURS=24
APPROVALS_SMALL_EDIT_MAX_RATIO=0.2

# ---- modules/inbox ----
# The reply classifier's model (core/modules/inbox/agents/classify-reply/README.md); empty, the port's first.
AI_MODEL_INBOX_CLASSIFY_REPLY=
# A reply classified below this confidence is only suggested, above 0 and at most 1; a change
# needs an api and worker restart.
INBOX_CLASSIFY_SUGGEST_BELOW=0.7

# ---- modules/enrichment ----
# The sources asked for a new lead's company and person, in order; `company-data` asks
# PROVIDER_COMPANY_DATA's adapters in that list's order; `linkedin` reads the company's LinkedIn page.
# A name that cannot run is left out at start.
ENRICHMENT_COMPANY_SOURCES=linkedin,company-data
ENRICHMENT_PERSON_SOURCES=country-ai
# Minutes between two ticks, the held leads one batch takes, and the days a company enriched for a
# new lead is not asked again for the next one.
ENRICHMENT_TICK_MINUTES=5
ENRICHMENT_BATCH_SIZE=20
ENRICHMENT_COMPANY_RETRY_DAYS=30
# The website source: the pages it reads of a company's site at most, and its AI task's model, empty
# for the LLM adapter's default.
ENRICHMENT_SITE_MAX_PAGES=5
AI_MODEL_ENRICHMENT_READ_COMPANY_SITE=
# The country namer's model, the source country-ai's; empty, the port's first.
AI_MODEL_ENRICHMENT_NAME_COUNTRY=
# The credits a verified email address costs, the email sources in order (`email-finder` asks
# PROVIDER_EMAIL_FINDER's adapters in that list's order; the lead's reply, the company's site and the
# address pattern's guesses first, free, since verifier checks are many and finders' searches few),
# and the most candidates one lookup verifies.
ENRICHMENT_CREDITS_PER_EMAIL=1
ENRICHMENT_EMAIL_SOURCES=reply,linkedin-contact-info,website,pattern,email-finder
ENRICHMENT_EMAIL_MAX_CANDIDATES=3
# Personal addresses for leads in the UK, the EU or the EEA: false by the owner's decision of
# 2026-11-13 (there a cold email to a personal address needs the person's consent).
ENRICHMENT_PERSONAL_EMAIL_EU_UK=false
# Days until a company's fact is asked again by its next run (0 to 3,650; 0, never).
ENRICHMENT_FACT_DAYS=180
# The days a verified address is trusted (RB-7.3.3: lower costs more paid checks, higher trusts older
# addresses), then the days a lookup that found none waits before the next; each 1 or more.
ENRICHMENT_EMAIL_VALID_DAYS=120
ENRICHMENT_EMAIL_NOT_FOUND_RETRY_DAYS=30
# An email lookup asked for each lead a research source finds, with the address a page printed with
# the person verified first (core/modules/enrichment/README.md "Settings"): true or false. Off, none
# is asked and a printed address stays the person's key only.
ENRICHMENT_LOOKUP_AT_FIND=true

# ---- apps/api ----
# compose.yaml sets API_PORT to 3001, where Caddy and the web image call the api, which publishes no
# port, and TRUST_PROXY to Caddy's address.
API_PORT=3001
API_PUBLIC_URL=https://whytide.example.com/api
REDIS_URL=redis://redis:6379
REDIS_PREFIX=
RATE_LIMIT_WORKSPACE_PER_MIN=600
RATE_LIMIT_AUTH_PER_IP_PER_MIN=20
RATE_LIMIT_WEBHOOK_PER_IP_PER_MIN=120
APP_PUBLIC_ORIGIN=https://whytide.example.com
WEB_DEV_ORIGIN=
TRUST_PROXY=

# ---- apps/worker ----
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
WORKER_HEALTH_PORT=3002
WORKER_SCHEDULES=on
# An alert of the same key within so many minutes is counted, not sent again; 1 or more, no maximum.
ALERTS_REPEAT_MINUTES=15

# ---- apps/web ----
# Not read on a server: the web's container listens on 3000 and calls the api at http://api:3001,
# which its image is built with (Dockerfile, NEXT_PUBLIC_API_URL).
WEB_PORT=
NEXT_PUBLIC_API_URL=
